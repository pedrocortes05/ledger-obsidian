{
  "name": "ledger-obsidian-pedro",
  "version": "0.3.3",
  "description": "Plain text accounting",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "jest",
    "test-watch": "jest --watchAll",
    "prettier": "prettier --write \"src/**/*.+(ts|tsx|json|html|css)\" \"tests/**/*.ts\"",
    "eslint": "eslint . --ext .ts,.tsx --fix",
    "check-ledger": "esbuild scripts/check-ledger.ts --bundle --platform=node --outfile=node_modules/.cache/check-ledger.js --log-level=warning && node node_modules/.cache/check-ledger.js"
  },
  "keywords": [],
  "author": "Pedro Cortes",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/chartist": "0.11.1",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.14.168",
    "@types/node": "22.19.1",
    "@types/react": "17.0.37",
    "@types/react-dom": "17.0.11",
    "@types/react-table": "7.7.9",
    "@types/styled-components": "5.1.15",
    "@typescript-eslint/eslint-plugin": "4.6.0",
    "@typescript-eslint/parser": "4.6.0",
    "esbuild": "0.28.2",
    "eslint": "7.12.1",
    "eslint-plugin-import": "2.22.1",
    "eslint-plugin-jsdoc": "30.7.3",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "eslint-plugin-simple-import-sort": "5.0.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-mock-extended": "1.0.10",
    "moment": "2.29.1",
    "obsidian": "1.13.1",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@popperjs/core": "2.9.2",
    "chartist": "0.11.4",
    "fuse.js": "6.4.6",
    "intro.js": "4.3.0",
    "intro.js-react": "0.5.0",
    "lodash": "4.17.21",
    "neverthrow": "3.0.0",
    "react": "^17.0.2",
    "react-chartist": "0.14.4",
    "react-dom": "^17.0.2",
    "react-popper": "^2.2.5",
    "react-table": "7.7.0",
    "styled-components": "5.3.3",
    "tslib": "^2.3.1"
  },
  "resolutions": {
    "styled-components": "^5",
    "@types/react": "17.0.37",
    "@types/react-dom": "17.0.11"
  }
